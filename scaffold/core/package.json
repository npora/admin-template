{
  "name": "admin-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "check": "prettier --check . && vue-tsc -b && node scripts/run-tests.mjs",
    "check:views": "node tests/integration/views.test.mjs",
    "check:locales": "node --test tests/integration/locales.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@npora/request": "^1.22.3",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.0",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
