{
  "name": "admin-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev.mjs mock",
    "dev:api": "node scripts/dev.mjs api",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "check": "pnpm run format:check && pnpm run typecheck && node scripts/check-optional.mjs && pnpm test",
    "check:session": "node scripts/run-tests.mjs session",
    "check:views": "node tests/integration/views.test.mjs",
    "check:errors": "node scripts/run-tests.mjs errors",
    "check:users": "node scripts/run-tests.mjs users",
    "check:rbac": "node scripts/run-tests.mjs rbac",
    "check:locales": "node --test tests/integration/locales.test.mjs",
    "check:examples": "node --test tests/integration/examples.test.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "build:cloudflare": "pnpm run typecheck && node deploy/cloudflare/build.mjs",
    "check:cloudflare": "cf deploy --prebuilt --dry-run",
    "deploy:cloudflare": "cf deploy --prebuilt"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@npora/request": "^1.22.3",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cf": "1.0.0-beta.28",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.0",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
