{
  "name": "admin-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "check": "prettier --check . && vue-tsc -b && node scripts/run-tests.mjs",
    "check:views": "node tests/integration/views.test.mjs",
    "check:locales": "node --test tests/integration/locales.test.mjs",
    "check:examples": "node scripts/run-tests.mjs --examples",
    "check:standalone": "node scripts/check-standalone.mjs",
    "build:cloudflare": "vue-tsc -p tsconfig.demo.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit && node deploy/cloudflare/build.mjs",
    "check:cloudflare": "cf deploy --prebuilt --dry-run",
    "deploy:cloudflare": "cf deploy --prebuilt",
    "dev:demo": "node scripts/demo.mjs",
    "build:demo": "vue-tsc -p tsconfig.demo.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit && node scripts/demo.mjs build",
    "check:backend": "node scripts/check-backend.mjs",
    "check:all": "prettier --check . && vue-tsc -p tsconfig.demo.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit && node scripts/run-tests.mjs --all",
    "typecheck:demo": "vue-tsc -p tsconfig.demo.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "update:presets": "node scripts/update-presets.mjs",
    "check:presets": "node scripts/check-presets.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@npora/request": "^1.22.3",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cf": "1.0.0-beta.28",
    "prettier": "3.10.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.0",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
