# 应用标题
VITE_APP_TITLE=Npora Admin

# API 请求前缀
VITE_API_PREFIX=/api

# Token 存储方式：session | local | memory
VITE_TOKEN_STORAGE=session

# 是否生成 gzip 压缩文件
VITE_BUILD_COMPRESS=true

# 是否生成构建分析报告
VITE_BUILD_ANALYZE=false


# 核心模式不加载演示页面；展示命令会自动开启。
VITE_DEMO_ENABLED=false

# 可选谷歌验证器界面入口，默认关闭；后端认证配置在 workers/api/src/config/auth.mjs
# 加密密钥只放后端 Secret，不能使用 VITE_ 前缀
VITE_AUTHENTICATOR_ENABLED=false

# 忘记密码时展示的管理员联系方式，可留空
VITE_PASSWORD_RESET_CONTACT=
